#!/usr/bin/env bash
# Usage: grokbot-notify <done|blocked|question|info> <message> [link...]
# Never fails the caller: always exits 0.

warn() { echo "grokbot-notify: $*" >&2; exit 0; }

[ $# -ge 2 ] || warn "usage: grokbot-notify <done|blocked|question|info> <message> [link...]"
status=$1 message=$2
shift 2
case "$status" in done|blocked|question|info) ;; *) warn "invalid status '$status'" ;; esac

env_file="${GROKBOT_CONFIG_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/grokbot/webhook.env}"
not_configured="set GROKBOT_WEBHOOK_URL and GROKBOT_WEBHOOK_AUTH, or run scripts/setup-webhook to fill $env_file; nothing sent"

# Reads KEY from the env file without executing it; undoes the wizard's single quoting.
read_value() {
  local line value sq="'\\''"
  line=$(grep -E "^$1=" "$env_file" | tail -n1) || return 0
  value=${line#*=}
  if [[ $value == \'*\' ]]; then value=${value:1:${#value}-2}; value=${value//"$sq"/\'}
  elif [[ $value == \"*\" ]]; then value=${value:1:${#value}-2}; fi
  printf '%s' "$value"
}

# Env vars win only as a complete pair, so the URL and the key never come from different places.
if [[ -z "${GROKBOT_WEBHOOK_URL:-}" || -z "${GROKBOT_WEBHOOK_AUTH:-}" ]]; then
  [ -r "$env_file" ] || warn "$not_configured"
  GROKBOT_WEBHOOK_URL=$(read_value GROKBOT_WEBHOOK_URL)
  GROKBOT_WEBHOOK_AUTH=$(read_value GROKBOT_WEBHOOK_AUTH)
fi
[[ -z "$GROKBOT_WEBHOOK_URL" || -z "$GROKBOT_WEBHOOK_AUTH" || "$GROKBOT_WEBHOOK_URL$GROKBOT_WEBHOOK_AUTH" == *PASTE_* ]] &&
  warn "$not_configured"
command -v python3 >/dev/null || warn "python3 not found, nothing sent"

toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || toplevel=$PWD
project=$(basename "$toplevel")
branch=$(git branch --show-current 2>/dev/null || true)

body=$(python3 -I -c '
import json, sys
f, p, b, s, m, *links = sys.argv[1:]
print(json.dumps({"from": f, "project": p, "branch": b, "status": s, "message": m, "links": links}))
' "claude-code" "$project" "$branch" "$status" "$message" "$@") || warn "failed to build JSON body, nothing sent"

# URL and auth go through a curl config on a pipe so they never appear in the process list.
curl_escape() { local s=${1//\\/\\\\}; printf '%s' "${s//\"/\\\"}"; }
curl -sS -o /dev/null --max-time 10 --fail \
  -K <(printf 'url = "%s"\nheader = "Authorization: %s"\n' \
    "$(curl_escape "$GROKBOT_WEBHOOK_URL")" "$(curl_escape "$GROKBOT_WEBHOOK_AUTH")") \
  -H 'Content-Type: application/json' --data-binary "$body" 2>/dev/null ||
  warn "request to Grok Bot webhook failed"
exit 0
